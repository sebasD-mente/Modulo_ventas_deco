{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "Track feature implementation state, DAG dependencies, verification commands, and pass-state gating evidence for agent-driven development",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "features"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "description": "Optional project or repository identifier"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "status",
          "dependencies",
          "required_files",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Unique feature identifier (e.g., feat-001)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Short feature name"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Optional alias for short feature title"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What this feature does"
          },
          "area": {
            "type": "string",
            "minLength": 1,
            "description": "Optional product domain or architectural area (e.g., chat, auth, infra)"
          },
          "user_visible_behavior": {
            "type": "string",
            "minLength": 1,
            "description": "Optional observable end-user behavior when the feature works"
          },
          "priority": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Execution priority (e.g., P0, P1 or numeric rank)"
          },
          "status": {
            "type": "string",
            "enum": [
              "not-started",
              "in-progress",
              "blocked",
              "done"
            ],
            "description": "Current implementation state (4 canonical states)"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Feature IDs that must be done before this one"
          },
          "required_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Physical deliverables on disk required before closing as 'done'"
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Executable verification commands required before claiming 'done'"
          },
          "evidence": {
            "type": "string",
            "description": "Verification evidence (command and output) mandatory when status is 'done'"
          },
          "notes": {
            "type": "string",
            "description": "Optional context or documented blocker reason when status is 'blocked'"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "done"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
