    "test:unit": "node --test tests/catalog/deduplication.test.js tests/catalog/fuzzy-typo-tolerance.test.js tests/catalog/phase-3-verification.test.js tests/catalog/tags-search-verification.test.js tests/sales/idempotency.test.js tests/sales/sale-sequences.test.js tests/schema/schema-robustness.test.js tests/frontend/phase5-frontend-ergonomics-resilience.test.js tests/sales/phase6-combos-offline-accelerators.test.js tests/adversarial/surgeries-zero-compromise.test.js tests/adversarial/surgery-053-multi-event-radar-contracts.test.js tests/adversarial/surgery-056-permanent-pos-and-pickup-accounting.test.js tests/adversarial/surgery-058-accounting-transparency-and-breakdown.test.js tests/adversarial/surgery-059-ui-polish-header-order-sync-camera.test.js tests/adversarial/surgery-060-ui-stand-header-discount-catalog.test.js tests/adversarial/surgery-061-ui-shipping-clean-colors-custom-modal.test.js tests/adversarial/surgery-064-ui-sales-edit-design-and-white-selectors.test.js tests/adversarial/surgery-065-events-compact-cards-and-back-navigation.test.js",
