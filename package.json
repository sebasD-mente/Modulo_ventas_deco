    "harness:check": "node scripts/audit-harness.js",
    "deploy": "node scripts/deploy-dokploy.js",
    "verify:prod": "node scripts/verify-production-live.js",
    "devtools:auth": "node scripts/auth-devtools.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "audit:syntax": "node scripts/audit-syntax.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.19.0",
