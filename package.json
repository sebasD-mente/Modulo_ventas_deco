{
  "name": "deko-eventsales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema Profesional de Gestión de Ventas por Eventos con IA Multimodal para Deco Vintage Guate y Deko Labs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/security/zero-trust.test.js",
    "test:security": "node --test tests/security/zero-trust.test.js",
    "audit:secrets": "node scripts/audit-secrets.js",
    "audit:monoliths": "node scripts/audit-monoliths.js",
    "harness:check": "npm run test:security && npm run audit:secrets && npm run audit:monoliths && npm run build",
    "deploy": "node scripts/deploy-dokploy.js",
    "devtools:auth": "node scripts/auth-devtools.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@google/genai": "^2.19.0",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  }
}
