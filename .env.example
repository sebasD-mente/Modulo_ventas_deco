# =============================================================================
#  Deko EventSales — Plantilla de Variables de Entorno (.env.example)
#  Proyecto: Módulo de Gestión de Ventas por Eventos con IA Multimodal
#  Deko Labs / Deco Vintage Guate
# =============================================================================
#
#  INSTRUCCIONES:
#  1. Copia este archivo a '.env' para desarrollo local y configuración del servidor.
#     cp .env.example .env
#  2. NUNCA subas archivos .env a repositorios Git.
#  3. Todos los valores sensibles deben inyectarse mediante variables de entorno
#     o a través del panel de Dokploy en producción.
# =============================================================================

# -- PUERTO Y ENTORNO ---------------------------------------------------------
PORT=3001
NODE_ENV=development

# -- BASE DE DATOS DEDICADA (PostgreSQL - Aislamiento Estricto en Dokploy) ----
# URL de conexión interna proporcionada por el servicio PostgreSQL de Dokploy
# Formato: postgresql://<usuario>:<contraseña>@<servicio-postgres-dokploy>:5432/<nombre_db>?schema=public
DATABASE_URL=postgresql://usuario_eventsales:tu_password_segura@nombre-servicio-db:5432/deko_eventsales_db?schema=public

# -- CATÁLOGO WEB EXTERNO (Sincronización Desacoplada) -----------------------
WEB_CATALOG_URL=https://decovintageguate.com

# -- SEGURIDAD Y AUTENTICACIÓN JWT --------------------------------------------
# Secreto para firmar tokens JWT (mínimo 32 caracteres criptográficos aleatorios)
JWT_SECRET=genera_un_secreto_aleatorio_seguro_para_jwt_aqui_2026
JWT_EXPIRES_IN=7d

# -- MOTOR DE IA MULTIMODAL (Google Gemini) -----------------------------------
# Clave de API de Google AI Studio (soporta claves estándar y Authorization Keys 'AQ.')
GEMINI_API_KEY=tu_clave_de_gemini_api_aqui
# Modelo oficial para procesamiento rápido y multimodal (audio, visión, chat)
GEMINI_MODEL=gemini-3.8-flash

# -- ALMACENAMIENTO MULTIMEDIA (Google Cloud Storage) --------------------------
# Nombre del bucket en GCS para comprobantes, fotos de pósters y notas de voz
GCS_BUCKET_NAME=deko-eventsales-media
# Credenciales ADC en Base64 (Opcional si se usa ADC estándar o entorno local)
GCS_CREDENTIALS_BASE64=
# Proyecto GCP (Opcional)
GCS_PROJECT_ID=tienda-deco-vintage-web

# -- CONFIGURACIÓN DE TENANT POR DEFECTO --------------------------------------
DEFAULT_TENANT_NAME=Deco Vintage Guate
DEFAULT_CURRENCY=GTQ
DEFAULT_CURRENCY_SYMBOL=Q
